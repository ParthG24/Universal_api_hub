# ==============================================================================
# Universal AI API Connector & Hub — Environment Configuration Template
# Copy this file to '.env' in the project root or backend folder and set your credentials.
# ==============================================================================

# Core Project Settings
PROJECT_NAME="Universal AI API Hub"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-random-32-byte-hex-string-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL for production / Neon / Supabase, or SQLite for local dev)
# Example for local development:
DATABASE_URL="sqlite:///./universal_hub.db"
# Example for PostgreSQL / Neon / Supabase:
# DATABASE_URL="postgresql+psycopg2://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AI Provider API Keys (Kept server-side only; NEVER exposed in frontend or client logs)
# Google Gemini API key: Get free at https://aistudio.google.com/
GEMINI_API_KEY=""

# Groq API key: Get ultra-fast free tier access at https://console.groq.com/
GROQ_API_KEY=""

# OpenAI API key (Optional third provider): https://platform.openai.com/
OPENAI_API_KEY=""

# Seed Admin Credentials (used by 'python -m app.seed' to initialize administrator)
ADMIN_EMAIL="admin@universalhub.dev"
ADMIN_PASSWORD="Admin123!"

# CORS Allowed Origins (Comma-separated origins for web frontend access)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://universal-ai-hub.vercel.app"]

# Frontend Next.js Public API URL (Used by the frontend to reach FastAPI backend)
# In production, set this to your deployed backend URL (e.g. https://universal-hub-api.onrender.com)
NEXT_PUBLIC_API_URL="http://localhost:8000"
